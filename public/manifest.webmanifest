{
  "id": "./",
  "name": "Editor — editor de fotos por capas",
  "short_name": "Editor",
  "description": "Editor de imágenes por capas en español que funciona en tu dispositivo: tus fotos no se suben a ningún sitio.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#1d1e21",
  "theme_color": "#1d1e21",
  "categories": [
    "photo",
    "graphics",
    "productivity"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/*": [
          ".png",
          ".jpg",
          ".jpeg",
          ".webp",
          ".gif",
          ".bmp"
        ],
        "image/vnd.adobe.photoshop": [
          ".psd"
        ],
        "application/x-editor-project": [
          ".edp"
        ]
      }
    }
  ],
  "share_target": {
    "action": "./?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            ".png",
            ".jpg",
            ".jpeg",
            ".webp",
            ".psd",
            ".edp",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}
